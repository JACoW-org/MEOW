+++
type = "doi"
title = {{ (contribution.title or contribution.code)|toml_string }}

{% if contribution %}
contents = [
"""contributions/{{ contribution.code|lower }}_doi.html""",
]
{% endif %}

{# Bibliographic metadata exposed in the page <head> (Highwire Press and Dublin Core) #}
{% set pages = (contribution.pages or "").split("-") %}
{% set issued = (contribution.issuance_date_iso or "").replace("-", "/") %}
{% set conference_title = [contribution.conference_code, contribution.venue, contribution.date]|select|join(", ") %}

cit_title = {{ (contribution.title or "").split()|join(" ")|toml_string }}
cit_authors = [
{% for author in contribution.primary_authors if author.last_name or author.first_name %}
{{ ((author.last_name ~ ", " ~ author.first_name) if author.last_name and author.first_name else (author.last_name or author.first_name))|toml_string }},
{% endfor %}
]
cit_keywords = [
{% for keyword in contribution.keywords if keyword %}
{{ keyword|toml_string }},
{% endfor %}
]
cit_abstract = {{ (contribution.abstract or "").split()|join(" ")|toml_string }}
cit_publication_date = {{ issued|toml_string }}
cit_publisher = {{ ([contribution.publisher, contribution.publisher_venue]|select|join(", "))|toml_string }}
cit_conference_title = {{ conference_title|toml_string }}
cit_journal_title = {{ (("Proceedings of " ~ contribution.conference_doi_name) if contribution.conference_doi_name else "")|toml_string }}
cit_firstpage = {{ (pages|first if pages|length > 1 else "")|toml_string }}
cit_lastpage = {{ (pages|last if pages|length > 1 else "")|toml_string }}
cit_doi = {{ contribution.doi_name|toml_string }}
cit_isbn = {{ contribution.isbn|toml_string }}
cit_issn = {{ (contribution.issn if contribution.issn != "0000-0000" else "")|toml_string }}
cit_language = "en"
cit_pdf_url = {{ pdf_url|toml_string }}
+++
