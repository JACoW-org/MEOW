<div class="title">Table of Sessions</div>

<ul class="sessions">
  {% for session in sessions %}
  {% if session.id %}
  <li class="session">
    <a data-href="session/{{ session.page_name }}/index.html" 
      onclick="openUrl(`session/{{ session.page_name }}/index.html`)" 
      href="javascript:void(0);">{% if session.code %}<b>{{ session.code }}</b> - {% endif %}<span>{{ session.title }}</span></a>
  </li>
  {% endif %}
  {% endfor %}
</ul>
